{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "vault",
    "search-vault",
    "search-vault-legacy",
    "hash-vault-password",
    "hash-vault-password-legacy",
    "verify-vault-password",
    "verify-vault-password-legacy"
  ]
}
