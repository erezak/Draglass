{
  "name": "draglass-editor",
  "version": "0.25.0",
  "private": true,
  "description": "Local Markdown workspace with tabs and connected notes",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts-build.mjs",
    "start": "node scripts-build.mjs && node scripts-start.mjs",
    "test": "node scripts-build.mjs && node --test",
    "dist": "node scripts-build.mjs && electron-builder",
    "dist:mac": "node scripts-build.mjs && electron-builder --mac",
    "dist:win": "node scripts-build.mjs && electron-builder --win",
    "dist:linux": "node scripts-build.mjs && electron-builder --linux",
    "dist:mac:dmg": "node scripts-build.mjs && electron-builder --mac dmg",
    "dist:mac:app": "node scripts-build.mjs && electron-builder --mac --dir",
    "check:demo": "node scripts-check-demo.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/markdown": "1.7.2",
    "dompurify": "^3.2.0",
    "lz-string": "1.5.0",
    "marked": "^17.0.0",
    "mermaid": "11.17.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yaml": "2.8.3",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "26.17.0",
    "esbuild": "^0.25.0",
    "jsdom": "30.1.2"
  },
  "build": {
    "appId": "dev.draglass.editor",
    "productName": "Draglass Editor",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**",
      "core/**",
      "dist/**",
      "assets/**",
      "demo-vault/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "executableName": "draglass-editor"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      },
      {
        "ext": "excalidraw",
        "name": "Excalidraw drawing",
        "description": "Excalidraw drawing",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/vnd.excalidraw+json"
      }
    ],
    "nsis": {
      "perMachine": true
    },
    "copyright": "Copyright \u00a9 2026 Erez Korn"
  },
  "productName": "Draglass Editor",
  "engines": {
    "node": ">=24.14.0"
  },
  "author": {
    "name": "Erez Korn",
    "email": "erakorn@outlook.com"
  }
}
